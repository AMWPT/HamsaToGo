<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Xcode promotes this to "production" automatically
	     when exporting an App Store build, so "development" is the correct
	     source value (matches what the Push Notifications capability writes). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Apple Pay. Must match exactly: the App ID's assigned merchant in the
	     Apple Developer portal, the ApplePayConfig merchantId in the app
	     (constants.dart), and Moyasar. -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.com.hamsa.hamsaFlutter</string>
	</array>
</dict>
</plist>
